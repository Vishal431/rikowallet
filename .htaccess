Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(bootstrap|config|database|docs|design|flutter_apk|resources|routes|storage|tests|vendor)(/|$) - [F,L]
RewriteRule ^(artisan|composer\.(json|lock)|package.*|phpunit\.xml|.*\.md)$ - [F,L]
RewriteRule ^$ public/ [L]
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

